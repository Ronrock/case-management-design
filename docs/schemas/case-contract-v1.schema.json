{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casemgmt.org/schemas/case-contract-v1.schema.json",
  "title": "Case contract v1",
  "type": "object",
  "required": ["key", "fields", "forms"],
  "properties": {
    "key": { "type": "string", "minLength": 1 },
    "version": { "const": "1.0" },
    "roles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "candidateGroups": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "fields": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/field" }
    },
    "forms": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/form" }
    },
    "searchProfiles": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "adHocActions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "slaBindings": { "type": "object" }
  },
  "additionalProperties": true,
  "$defs": {
    "field": {
      "type": "object",
      "required": ["schema"],
      "properties": {
        "schema": { "type": "object" },
        "readRoles": { "type": "array", "items": { "type": "string" } },
        "writeRoles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "form": {
      "type": "object",
      "required": ["schema"],
      "properties": {
        "schema": { "type": "object" },
        "uiSchema": { "type": "object" }
      }
    },
    "action": {
      "type": "object",
      "required": ["id", "type", "roles"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["TASK", "PROCESS", "MESSAGE"] },
        "name": { "type": "string" },
        "roles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "formRef": { "type": "string" },
        "candidateGroups": { "type": "array", "items": { "type": "string" } },
        "processDefinitionKey": { "type": "string" },
        "messageName": { "type": "string" },
        "availabilityExpression": { "type": "string" }
      }
    }
  }
}

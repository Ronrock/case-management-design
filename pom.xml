<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.casemgmt</groupId>
  <artifactId>case-management-root</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Case Management on Operaton</name>

  <modules>
    <module>case-management-core</module>
    <module>case-management-engine-embedded</module>
    <module>case-management-engine-remote</module>
    <module>case-management-rest</module>
    <module>case-management-spring-boot-starter</module>
    <module>case-management-poc-app</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <version.operaton>2.1.3</version.operaton>
    <!-- DO NOT downgrade below 1.21.4 - that is the floor, not a whim.
         1.21.3's DockerClientProviderStrategy hardcodes the connectivity-probe API version
         at v1.32; Docker Engine 29.x raised its MinAPIVersion to 1.40, so every probe against
         a current Docker Desktop daemon fails with "client version 1.32 is too old" even
         though the daemon is perfectly healthy (upstream testcontainers-java #11210/#11232,
         confirmed against a real Docker Engine 29.6.2 daemon during Task 2). 1.21.4 probes
         v1.44 first and only falls back to v1.32 for genuinely old engines - bumped for that
         fix alone; still the 1.21.x line the skew-avoidance pin below targets. -->
    <version.testcontainers>1.21.4</version.testcontainers>
    <version.json-schema-validator>1.5.8</version.json-schema-validator>
    <version.archunit>1.4.1</version.archunit>
    <version.swagger-request-validator>2.44.9</version.swagger-request-validator>
    <version.mockito>5.20.0</version.mockito>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- operaton-bom manages only Operaton's own artifact versions (engine, webapp, etc.);
           it does NOT supply the Spring Boot or Spring Framework versions. See the
           operaton-bpm-spring-boot-starter import below for what actually pins those. -->
      <dependency>
        <groupId>org.operaton.bpm</groupId>
        <artifactId>operaton-bom</artifactId>
        <version>${version.operaton}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- operaton-bom (above) only manages Operaton artifact versions - it does NOT
           import spring-boot-dependencies. operaton-bpm-spring-boot-starter's own POM
           does (it imports operaton-core-internal-dependencies + spring-boot-dependencies
           at 4.0.7). Importing it here as a BOM (type=pom/scope=import, in addition to the
           plain jar dependency entry below) is how Operaton's actual pinned Spring Boot /
           Spring Framework / Jackson versions flow into this reactor without us declaring
           a competing version ourselves. -->
      <dependency>
        <groupId>org.operaton.bpm.springboot</groupId>
        <artifactId>operaton-bpm-spring-boot-starter</artifactId>
        <version>${version.operaton}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.operaton.bpm.springboot</groupId>
        <artifactId>operaton-bpm-spring-boot-starter</artifactId>
        <version>${version.operaton}</version>
      </dependency>
      <dependency>
        <groupId>org.operaton.bpm.springboot</groupId>
        <artifactId>operaton-bpm-spring-boot-starter-rest</artifactId>
        <version>${version.operaton}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${version.testcontainers}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Pin the testcontainers core artifact explicitly. Without this, Operaton's own
           internal BOM chain (pulled in above via the operaton-bpm-spring-boot-starter
           import) directly overrides org.testcontainers:testcontainers to 2.0.5, while
           oracle-free/jdbc/database-commons stay on our declared 1.21.4 line (testcontainers
           2.0.5 does not even publish an oracle-free artifact). That skew would silently put
           a mismatched core jar on the classpath. This direct entry, declared in our own
           POM, takes precedence over anything arriving via import and keeps the whole
           testcontainers family on 1.21.4. -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers</artifactId>
        <version>${version.testcontainers}</version>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${version.json-schema-validator}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${version.archunit}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.atlassian.oai</groupId>
        <artifactId>swagger-request-validator-core</artifactId>
        <version>${version.swagger-request-validator}</version>
        <scope>test</scope>
      </dependency>

      <!-- Internal modules -->
      <dependency>
        <groupId>org.casemgmt</groupId>
        <artifactId>case-management-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.casemgmt</groupId>
        <artifactId>case-management-engine-embedded</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.casemgmt</groupId>
        <artifactId>case-management-engine-remote</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.casemgmt</groupId>
        <artifactId>case-management-rest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.casemgmt</groupId>
        <artifactId>case-management-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Declared under <plugins> (not just <pluginManagement>) so every child module
         inherits this execution automatically, with no per-module opt-in required.

         Standardises on surefire running *IT classes under the ordinary `test` phase,
         reactor-wide. This project has no Testcontainers-backed or otherwise genuinely
         separate "integration test" environment for its *IT classes (see
         case-management-engine-embedded's EmbeddedEngineGatewayIT: full Spring context,
         real Operaton engine, but on in-memory H2 - fast enough to run as part of `test`).
         A maven-failsafe-plugin execution previously sat in <pluginManagement> here but was
         never bound in any module's <build><plugins>, so it did nothing: *IT classes matched
         neither surefire's default includes (**/*Test.java, **/*Tests.java, **/*TestCase.java)
         nor any active failsafe execution, and `mvn test` silently reported zero tests for
         them - a false green, not a skip anyone would notice. Removed rather than fixed
         forward, since running *IT classes as ordinary tests (not a separate
         integration-test/verify phase) is what every existing task brief in this project
         already assumes (`./mvnw -pl <module> test`, not `verify`). -->
    <plugins>
      <!-- javac -parameters, reactor-wide. Required, not cosmetic: Spring MVC resolves
           @PathVariable/@RequestParam/@RequestHeader names by reflection whenever the annotation
           does not spell one out, and without parameter names in the bytecode every such handler
           argument fails at request time with "Name for argument of type [java.lang.String] not
           specified, and parameter name information not available via reflection" — i.e. a 500
           from every controller method taking a path variable. spring-boot-starter-parent
           normally sets this flag; this project deliberately has no Boot parent (Operaton's BOM
           supplies the Boot version — see the dependencyManagement notes above), so it is set
           here instead. Found by Task 24: the first run of its HTTP tests returned 500 with
           exactly that message from every endpoint that takes a {caseId}.
           Version pinned so the build does not depend on which compiler-plugin version the
           running Maven happens to default to. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- Keep module-level integration tests isolated from one another. The core and PoC
               modules both use Oracle Testcontainers; running each module's test set in its own
               forked JVM lets Testcontainers tear down the module's Oracle process before the
               next module starts another one. Without this, a full reactor run can keep the core
               Oracle container alive in the Maven JVM while the PoC module starts its own Oracle
               container, which is enough to OOM local Docker in realistic developer setups. -->
          <forkCount>1</forkCount>
          <reuseForks>true</reuseForks>
          <argLine>-javaagent:${settings.localRepository}/org/mockito/mockito-core/${version.mockito}/mockito-core-${version.mockito}.jar -Xshare:off</argLine>
          <includes>
            <include>**/*Test.java</include>
            <include>**/*Tests.java</include>
            <include>**/*TestCase.java</include>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

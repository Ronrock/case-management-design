<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!-- A cancellation is a terminal SLA fact in its own right.  Keep it separate from MET_AT_
       so support/audit can distinguish a commitment achieved by the case from one stopped when
       the case itself was cancelled. -->
  <changeSet id="cm-sla-root-terminalization-column" author="casemgmt">
    <preConditions onFail="MARK_RAN">
      <not><columnExists tableName="CM_SLA_RECORD" columnName="CANCELLED_AT_"/></not>
    </preConditions>
    <addColumn tableName="CM_SLA_RECORD">
      <column name="CANCELLED_AT_" type="TIMESTAMP WITH TIME ZONE"/>
    </addColumn>
  </changeSet>

  <changeSet id="cm-sla-root-terminalization-status" author="casemgmt">
    <sql>ALTER TABLE CM_SLA_RECORD DROP CONSTRAINT CK_CM_SLAR_STATUS</sql>
    <sql>ALTER TABLE CM_SLA_RECORD ADD CONSTRAINT CK_CM_SLAR_STATUS CHECK (STATUS_ IN ('RUNNING','PAUSED','MET','CANCELLED','BREACHED'))</sql>
  </changeSet>
</databaseChangeLog>

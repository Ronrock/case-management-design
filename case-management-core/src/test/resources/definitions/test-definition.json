{
  "key": "widget-review",
  "name": "Widget Review",
  "orchestrationMode": "BPMN",
  "tenantId": "t1",
  "roles": ["owner", "handler", "reviewer"],
  "candidateGroups": ["reviewers"],
  "fields": {},
  "forms": {
    "reviewForm": {
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["outcome"],
        "properties": {
          "outcome": { "type": "string", "enum": ["approve", "reject"] },
          "note": { "type": "string" }
        }
      }
    }
  }
}
